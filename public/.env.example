# Скопируйте этот файл как .env и вставьте новые данные Telegram-бота.
# Не используйте токен, который уже публиковался или был на скриншоте.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль для входа на /admin.html. Используйте длинный уникальный пароль.
ADMIN_PASSWORD=

# Более безопасная альтернатива ADMIN_PASSWORD: PHP-хеш password_hash().
# Если заполнены обе переменные, используется ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH=

# Только если сайт стоит за доверенным reverse proxy/CDN.
# Укажите точные IP/CIDR прокси; без allowlist заголовкам клиента доверия нет.
ADMIN_TRUSTED_PROXY_CIDRS=
# Допустимые значения: CF-Connecting-IP или X-Real-IP.
ADMIN_CLIENT_IP_HEADER=CF-Connecting-IP
