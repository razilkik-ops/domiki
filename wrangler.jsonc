{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malta-retreat-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "malta-retreat-content",
      "database_id": "9b526b89-e687-4e06-aee7-0edfe4063799",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
